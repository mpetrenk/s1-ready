# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Generated datasets (ad-hoc runs). The curated demo datasets under examples/
# are whitelisted below so the case study is reproducible from a fresh clone.
*.jsonl
*.jsonl.spec.json

# Keep the committed demo/case-study datasets.
!examples/sms_spam.jsonl
!examples/sms_spam.jsonl.spec.json
!examples/sms_spam.test.jsonl
!examples/sms_spam.test.jsonl.spec.json

# Caches
.pytest_cache/
.mypy_cache/
.DS_Store

# Auto-label experiment: downloaded corpus + regenerable run outputs.
# The committed out_full/label_quality.json (a .json, not .jsonl) is the one
# artifact we keep; everything else here is large or regenerable.
examples/case_study/auto_label/SMSSpamCollection
examples/case_study/auto_label/sms.zip
examples/case_study/auto_label/out/
examples/case_study/auto_label/out2/
examples/case_study/auto_label/out_balanced/
examples/case_study/auto_label/**/*.train.py
